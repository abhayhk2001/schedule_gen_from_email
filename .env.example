# One of these is required, depending on which "model" the request selects:
OPENAI_API_KEY=
MINIMAX_API_KEY=

# Optional overrides:
# MINIMAX_BASE_URL=https://api.minimax.io/v1

# Required for the Outlook add-in's Microsoft Graph SSO.
# Value source: Microsoft Entra admin center ->
#   Applications -> App registrations -> <your app> -> Overview ->
#   "Application (client) ID".
# This is a public identifier, not a secret, but kept out of source
# control so it can be set per-environment and rotated independently.
# Local dev: paste into .env.local (already gitignored).
# Vercel production:
#   vercel env add AZURE_CLIENT_ID production
# Consumed by api/manifest.xml.ts -> lib/manifest-template.ts.
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
