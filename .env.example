# One of these is required, depending on which "model" the request selects:
OPENAI_API_KEY=
MINIMAX_API_KEY=

# Optional. Override the MiniMax API base URL.
# MINIMAX_BASE_URL=https://api.minimax.io/v1

# Required for the Outlook add-in's Microsoft Graph sign-in.
# Value source: Microsoft Entra admin center ->
#   Applications -> App registrations -> <your app> -> Overview ->
#   "Application (client) ID".
# This is a public identifier, not a secret, but kept out of source
# control so it can be set per-environment and rotated independently.
# Local dev: paste into .env.local (already gitignored).
# Vercel production (must be a plain Config value, not a Secret --
# the build step cannot read Secrets and needs this to generate the
# manifest):
#   vercel env add AZURE_CLIENT_ID production --type config
# Consumed by scripts/build-manifest.mjs and api/auth-config.ts.
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Optional. Override the Microsoft Identity authority used by the
# add-in's sign-in dialog. Defaults to /common (multi-tenant; accepts
# any work/school account plus personal Microsoft accounts).
# Other shapes:
#   https://login.microsoftonline.com/organizations  -> work/school only
#   https://login.microsoftonline.com/<tenant-id>    -> single-tenant lock
# Consumed by lib/oauth-config.ts, served via /api/auth-config.
# OAUTH_AUTHORITY=

# Optional. Override the OAuth redirect URI. Must match a redirect URI
# registered on the Entra app under the "Single-page application"
# platform, exactly -- see docs/AUTH.md section 9.
# Defaults to the production callback page.
# Consumed by lib/oauth-config.ts, served via /api/auth-config.
# OAUTH_REDIRECT_URI=https://schedule-gen-from-email.vercel.app/outlook-addin/auth-callback.html
