# One of these is required, depending on which "model" the request selects:
OPENAI_API_KEY=
MINIMAX_API_KEY=

# Optional overrides:
# MINIMAX_BASE_URL=https://api.minimax.io/v1

# Required for the Outlook add-in's Microsoft Graph SSO:
# Azure App Registration -> Application (client) ID.
# Public identifier (not a secret), but kept out of source control so it
# is set per-environment. Consumed by /api/manifest.xml.
AZURE_CLIENT_ID=
